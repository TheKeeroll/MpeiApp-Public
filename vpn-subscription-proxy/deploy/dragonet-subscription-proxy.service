[Unit]
Description=DragoNet subscription HTTPS proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dragonet-proxy
Group=dragonet-proxy
WorkingDirectory=/opt/vpn-subscription-proxy
EnvironmentFile=/etc/dragonet-subscription-proxy.env
ExecStart=/usr/bin/node /opt/vpn-subscription-proxy/dist/server.js
Restart=on-failure
RestartSec=5
UMask=0077

# StateDirectory is created as /var/lib/dragonet-subscription-proxy and owned
# by the service user. It holds only HMAC cooldown records.
StateDirectory=dragonet-subscription-proxy
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dragonet-subscription-proxy
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
