[Unit]
Description=DragoNet subscription HTTPS proxy for Let's Encrypt certificate %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dragonet-proxy
Group=dragonet-proxy
WorkingDirectory=/opt/vpn-subscription-proxy
EnvironmentFile=/etc/dragonet-subscription-proxy.env
# PID 1 reads this original pair from /etc/letsencrypt/live at every start.
# CREDENTIALS_DIRECTORY exposes it only to the unprivileged process, without
# a persistent copy or a custom Certbot deploy-hook.
LoadCredential=fullchain.pem:/etc/letsencrypt/live/%i/fullchain.pem
LoadCredential=privkey.pem:/etc/letsencrypt/live/%i/privkey.pem
ExecStart=/usr/bin/node /opt/vpn-subscription-proxy/dist/server.js
Restart=on-failure
RestartSec=5
UMask=0077

# StateDirectory is created as /var/lib/dragonet-subscription-proxy and owned
# by the service user. It holds only HMAC cooldown records.
StateDirectory=dragonet-subscription-proxy
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dragonet-subscription-proxy
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Fastify asks Node to enumerate interfaces after binding a wildcard IPv4
# listener. On Linux that uses AF_NETLINK; no network listener is opened by it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
