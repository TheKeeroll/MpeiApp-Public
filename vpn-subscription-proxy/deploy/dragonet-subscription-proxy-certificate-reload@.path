[Unit]
Description=Watch Certbot and S-UI certificate %i for DragoNet proxy

[Path]
# Certbot atomically swaps live symlinks. Watching the directory and both
# links also covers S-UI/acme.sh, which may replace files or write in place.
# Missing paths are allowed; no certificate directories are created here.
PathChanged=/etc/letsencrypt/live/%i
PathChanged=/etc/letsencrypt/live/%i/fullchain.pem
PathChanged=/etc/letsencrypt/live/%i/privkey.pem
PathChanged=/root/cert/%i
PathChanged=/root/cert/%i/fullchain.pem
PathChanged=/root/cert/%i/privkey.pem
# The matching .service (same name and instance) is activated by default.

[Install]
WantedBy=multi-user.target
