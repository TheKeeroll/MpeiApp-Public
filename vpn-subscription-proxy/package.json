{
  "name": "vpn-subscription-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "HTTPS gateway between MpeiApp and the DragoNet S-UI panel",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
