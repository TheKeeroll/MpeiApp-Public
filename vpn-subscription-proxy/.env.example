# Public HTTPS listener. Port 443 is occupied on the target VPS, so use a
# different public port here and use the same value in DRAGONET_PROXY_PORT in
# MpeiApp during stage 5.2.
PROXY_LISTEN_HOST=0.0.0.0
PROXY_LISTEN_PORT=8443
PROXY_REQUEST_PATH=/api/v1/subscription

# Private S-UI panel connection. Keep the real values only in the root-owned
# EnvironmentFile on the VPS, never in this repository.
VPN_PANEL_BASE_URL=https://panel.example.com:2053/panel-secret
VPN_PANEL_TOKEN=replace-with-the-panel-token
VPN_DEMO_INBOUNDS=[12,13,15]

# Public subscription endpoint served by S-UI. The hostname is discovered from
# the TLS certificate; this project only needs its port and URL path prefix.
VPN_SUBSCRIPTION_PORT=443
VPN_SUBSCRIPTION_PATH_PREFIX=/sub

# Generate at least 32 random bytes, for example:
# openssl rand -hex 32
DEMO_COOLDOWN_HMAC_KEY=replace-with-at-least-32-random-bytes

# Runtime state is intentionally outside the repository.
STATE_DIRECTORY=/var/lib/dragonet-subscription-proxy

# Limits are deliberately small. Values are interpreted in milliseconds or
# seconds as indicated by their names.
REQUEST_TIMEOUT_MS=10000
REQUEST_RATE_LIMIT_MAX=30
REQUEST_RATE_LIMIT_WINDOW_SECONDS=60
VERIFY_CACHE_TTL_SECONDS=30
MAX_REQUEST_BODY_BYTES=1024

# Leave empty for direct HTTPS. If a TCP-aware trusted reverse proxy is added,
# list only its source IP addresses and make it strip client-provided XFF.
TRUSTED_REVERSE_PROXY_IPS=

# Matches the form used by the existing DragoNet Telegram bot.
DEMO_VLESS_FLOW=xtls-rprx-vision
