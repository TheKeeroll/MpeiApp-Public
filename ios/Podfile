# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

minimum_ios_version = '15.6'
platform :ios, minimum_ios_version
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MpeiApp' do
  config = use_native_modules!

  # yandex-mobile-ads is registered by React Native autolinking here; its
  # podspec installs the matching YandexMobileAds 8.5.0 native SDK.
  # These adapter revisions require YandexMobileAds ~> 8.5.0.
  pod 'BigoADSYandexMobileAdsAdapters', '5.0.6.5'
  pod 'MyTargetYandexMobileAdsAdapters', '5.36.2.5'
  pod 'ChartboostYandexMobileAdsAdapters', '9.13.0.1'

  use_react_native!(
    :path => config[:reactNativePath],

    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  #pod 'mailcore2-ios'

  pod 'RNScreens', :path => '../node_modules/react-native-screens'

  pod 'RNReanimated', :path => '../node_modules/react-native-reanimated'

  pod 'RNGestureHandler', :path => '../node_modules/react-native-gesture-handler'

  pod 'react-native-change-icon', :path => '../node_modules/react-native-change-icon'

  pod 'RNVectorIcons', :path => '../node_modules/react-native-vector-icons'

  pod 'RNYamap', :path => '../node_modules/react-native-yamap'

  #pod 'react-native-mail', :path => '../node_modules/react-native-mail'

  pod 'MMKVCore', :modular_headers => true

  #   pod 'Firebase', :modular_headers => true
  #   pod 'FirebaseCoreInternal', :modular_headers => true
  #   pod 'GoogleUtilities', :modular_headers => true
  #   pod 'FirebaseCore', :modular_headers => true
  #pod 'FirebaseCoreExtension'#, :modular_headers => true 
  #pod 'FirebaseAppCheckInterop'#, :modular_headers => true
  #pod 'FirebaseAuthInterop'#, :modular_headers => true
  #pod 'FirebaseMessagingInterop'#, :modular_headers => true
  #pod 'GTMSessionFetcher'#, :modular_headers => true

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
        installer,
        config[:reactNativePath],
        :mac_catalyst_enabled => false,
        # :ccache_enabled => true
    )

    # Xcode 27 rejects Pod targets below iOS 15, including privacy bundles.
    # React Native only updates native Pod targets; cover every generated target
    # after its hook, using the app minimum without lowering newer requirements.
    minimum = Gem::Version.new(minimum_ios_version)
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current) < minimum
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
        end
      end
    end
  end
end
