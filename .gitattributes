# Auto detect text files and perform LF normalization
* text=auto

# Keep unified patches valid for git apply and patch-package on Windows.
patches/*.patch text eol=lf

# Deployment scripts are transferred from Windows to Linux inside a tar archive.
vpn-subscription-proxy/deploy/*.sh text eol=lf

# Xcode Cloud invokes these scripts directly on macOS.
ios/ci_scripts/*.sh text eol=lf

# CocoaPods hashes the Podfile contents; keep its checksum stable on Windows/macOS.
ios/Podfile text eol=lf
