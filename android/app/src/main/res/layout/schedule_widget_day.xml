<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_day_root" android:layout_width="0dp" android:layout_weight="1"
    android:layout_height="wrap_content" android:layout_margin="1dp" android:padding="2dp"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/app_widget_rounded_corner">
    <TextView android:id="@+id/widget_day_weekday" style="@style/ScheduleWidgetText"
        android:textSize="9sp" android:gravity="center" />
    <TextView android:id="@+id/widget_day_number" style="@style/ScheduleWidgetText"
        android:minWidth="22dp" android:minHeight="22dp" android:padding="2dp" android:gravity="center"
        android:textStyle="bold" android:background="@drawable/schedule_widget_date" />
    <TextView android:id="@+id/widget_day_month" style="@style/ScheduleWidgetText"
        android:textSize="9sp" android:textColor="#C4BCD1" android:gravity="center" />
</LinearLayout>
