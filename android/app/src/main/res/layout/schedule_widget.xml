<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/app_widget_initial_rounded_corner">

    <LinearLayout android:id="@+id/widget_week_controls"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_week_previous" style="@style/ScheduleWidgetArrow"
            android:text="‹" android:contentDescription="Предыдущая неделя" />
        <TextView android:id="@+id/widget_week_title" style="@style/ScheduleWidgetText"
            android:layout_width="0dp" android:layout_weight="1" android:gravity="center"
            android:paddingStart="2dp" android:paddingEnd="2dp" android:maxLines="2" android:textStyle="bold"
            android:text="Расписание" />
        <TextView android:id="@+id/widget_week_next" style="@style/ScheduleWidgetArrow"
            android:text="›" android:contentDescription="Следующая неделя" />
        <TextView android:id="@+id/widget_today" style="@style/ScheduleWidgetButton"
            android:layout_width="58dp" android:layout_marginStart="4dp" android:text="Сегодня"
            android:textColor="#BB86FC" android:contentDescription="Вернуться к сегодняшнему дню" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_day_strip"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_days_previous" style="@style/ScheduleWidgetArrow"
            android:text="‹" android:contentDescription="Предыдущие дни этой недели" />
        <LinearLayout android:id="@+id/widget_days" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" />
        <TextView android:id="@+id/widget_days_next" style="@style/ScheduleWidgetArrow"
            android:text="›" android:contentDescription="Следующие дни этой недели" />
    </LinearLayout>

    <TextView android:id="@+id/date_text" style="@style/ScheduleWidgetText"
        android:layout_width="match_parent" android:textColor="#C4BCD1" android:gravity="center_vertical"
        android:text="Расписание ещё не загружено" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/schedule_container" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/widget_empty" style="@style/ScheduleWidgetText"
            android:layout_width="match_parent" android:layout_height="match_parent" android:maxLines="4"
            android:gravity="center" android:text="Откройте MpeiApp, чтобы загрузить расписание." />
    </FrameLayout>

    <LinearLayout android:id="@+id/widget_lesson_controls"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:visibility="gone">
        <TextView android:id="@+id/widget_lessons_previous" style="@style/ScheduleWidgetArrow"
            android:text="‹" android:contentDescription="Предыдущие занятия" />
        <TextView android:id="@+id/widget_lesson_page" style="@style/ScheduleWidgetText"
            android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#C4BCD1" />
        <TextView android:id="@+id/widget_lessons_next" style="@style/ScheduleWidgetArrow"
            android:text="›" android:contentDescription="Следующие занятия" />
    </LinearLayout>

    <TextView android:id="@+id/widget_notice" style="@style/ScheduleWidgetText"
        android:layout_width="match_parent" android:textSize="10sp" android:maxLines="2"
        android:textColor="#AAA2B7" android:gravity="center_vertical"
        android:text="Откройте MpeiApp, чтобы обновить расписание в виджете." />
</LinearLayout>
